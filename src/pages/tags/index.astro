---
import Base from "@/layouts/Base.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";

import { FaHashtag } from "react-icons/fa";

const tags = await getTaxonomy("posts", "tags");
---

<Base title={"Tags"}>
  <section class="py-8 text-center max-w-2xl mx-auto px-4">
  <h1 class="text-3xl md:text-4xl font-bold text-dark mb-3">
    Einfaldur & ljúffengur matur fyrir alla daga
  </h1>
  <p class="text-text text-lg leading-relaxed">
    Verkefnið mitt snýst um að gera matargerð skemmtilega, fljótlega og ótrúlega góða. Kíktu á nýjustu uppskriftirnar hér fyrir neðan!
  </p>
</section>
  <section class="section">
    <div class="container text-center">
      <h1 class="h2 page-heading">Tags</h1>
      <ul class="space-x-4">
        {
          tags.map((tag) => (
            <li class="inline-block">
              <a
                href={`/tags/${tag}`}
                class="rounded-lg bg-light px-4 py-2 text-dark transition hover:bg-primary hover:text-white flex items-center group"
              >
                <FaHashtag className="mr-1 text-primary group-hover:text-white transition" />
                {humanize(tag || "")}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
