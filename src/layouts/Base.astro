---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { AstroFont } from "astro-font";
import { ClientRouter } from "astro:transitions";

// Vercel Mælingar
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

// font families
const pf = theme.fonts.font_family.primary;

let fontPrimary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  categories?: string[];
}

// distructure frontmatters
const { 
  title, 
  meta_title, 
  description, 
  image, 
  noindex, 
  canonical,
  categories 
} = Astro.props;

// Reikna út rétta texta og slóðir
const currentTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title
);
const currentDescription = plainify(
  description ? description : config.metadata.meta_description
);
const imageUrl = image ? image : config.metadata.meta_image;
const fullImageUrl = imageUrl.startsWith("http")
  ? imageUrl
  : `${config.site.base_url}${imageUrl.startsWith("/") ? "" : "/"}${imageUrl}`;
const pageUrl = canonical ? canonical : `${config.site.base_url}${Astro.url.pathname}`;

// Búa til einfalt Uppskrifta-Schema fyrir Google ef þetta er uppskrift (með mynd og description)
const isRecipe = title && image;
const recipeSchema = isRecipe
  ? {
      "@context": "https://schema.org/",
      "@type": "Recipe",
      "name": currentTitle,
      "image": [fullImageUrl],
      "description": currentDescription,
      "recipeCategory": categories && categories.length > 0 ? categories[0] : undefined
    }
  : null;
---

<!doctype html>
<html lang="is">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }

    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
      ]}
    />

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{currentTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={pageUrl} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={currentDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title (Open Graph fyrir Facebook, Pinterest, o.fl.) -->
    <meta property="og:title" content={currentTitle} />
    <meta property="og:description" content={currentDescription} />
    <meta property="og:type" content={isRecipe ? "article" : "website"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullImageUrl} />

    <!-- twitter-title -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={currentTitle} />
    <meta name="twitter:description" content={currentDescription} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Recipe Schema fyrir Google leitarniðurstöður -->
    {
      recipeSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(recipeSchema)}
        />
      )
    }

    <script 
      id="Cookiebot" 
      src="https://consent.cookiebot.com/uc.js" 
      data-cbid="2ec8b4bb-10cc-4785-b007-e54d13ea947b" 
      data-blockingmode="auto" type="text/javascript">
    </script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />

    <!-- Vercel Analytics & Speed Insights mælingar -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>